# PostgreSQL connection used by the application (replace these placeholders).
DATABASE_URL=postgresql+psycopg://campus_user:change_me@localhost:5432/smart_campus

# Generate a random secret: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Required; no default secret is provided.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional local Docker database password; defaults to campus_local_only.
# Use URL-safe characters because Compose embeds this value in DATABASE_URL.
# POSTGRES_PASSWORD=replace_with_a_local_password
